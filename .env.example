NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key (serverseitig, nie an den Client!). Nur für den
# Stripe-Webhook, der ohne Nutzer-Session Kaufeinträge schreiben muss.
SUPABASE_SERVICE_ROLE_KEY=

# KI-Pipeline (serverseitig, nie an den Client). Ohne Keys sind die
# KI-Knöpfe im Studio ausgeblendet.
DEEPL_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ElevenLabs-Stimme pro Genre überschreiben (Voice-ID).
# ELEVENLABS_VOICE_WISSEN=
# ELEVENLABS_VOICE_KINDER=
# ELEVENLABS_VOICE_ROMANTIK=
# ELEVENLABS_VOICE_SAGEN=
# ELEVENLABS_VOICE_SCHULE=

# Stripe (serverseitig, nie an den Client). Ohne STRIPE_SECRET_KEY bleiben
# kostenpflichtige Touren frei zugänglich (kein Kauf-Zwang ohne Setup).
STRIPE_SECRET_KEY=
# Webhook-Signing-Secret aus dem Stripe-Dashboard (Endpoint /api/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=

# Kartenkacheln im Player (optional). Kostenloser Hobby-Plan bei
# thunderforest.com registrieren (erlaubt kommerzielle Nutzung, 150k
# Kacheln/Monat). Ohne Key: Standard-OpenStreetMap-Kacheln.
NEXT_PUBLIC_THUNDERFOREST_API_KEY=

# Fussweg-Routing zur nächsten Station im Player (optional). Kostenloser
# Key bei openrouteservice.org registrieren (2500 Anfragen/Tag). Ohne Key:
# Luftlinie statt echter Route.
OPENROUTESERVICE_API_KEY=
